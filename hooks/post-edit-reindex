#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Locate skelesearch binary: PATH first, then local debug build
if command -v skelesearch &>/dev/null; then
    SK="skelesearch"
elif [ -x "$PLUGIN_ROOT/target/debug/skelesearch" ]; then
    SK="$PLUGIN_ROOT/target/debug/skelesearch"
else
    exit 0
fi

STATUS="$("$SK" status --json 2>/dev/null)" || { exit 0; }

# Detect watch mode without python3 or jq: match the literal JSON field.
# grep -q returns 0 on match, non-zero otherwise — safe with set -e because
# the conditional form "if ...; then" suppresses exit on non-zero.
if printf '%s' "$STATUS" | grep -q '"watching"[[:space:]]*:[[:space:]]*true'; then
    WATCHING=true
else
    WATCHING=false
fi

# If watch mode is active, the watcher handles re-indexing
if [ "$WATCHING" = "true" ]; then
    exit 0
fi

# Spawn background incremental index and return immediately
"$SK" index . &>/dev/null &
exit 0
